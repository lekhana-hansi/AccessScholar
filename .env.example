PORT=5000
# Use the PostgreSQL connection string from your Supabase project or local PostgreSQL.
# Uncomment and replace with your real connection string to use PostgreSQL.
# DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@YOUR_HOST:5432/postgres?sslmode=require
PG_POOL_MAX=10
# Generate a long random value locally; never commit the real token.
ADMIN_API_TOKEN=REPLACE_WITH_A_LONG_RANDOM_SECRET
# Optional: directory containing countries.json, sources.json, scholarships.json.
# ACCESS_SCHOLAR_DATA_DIR=./local-scholarship-data
